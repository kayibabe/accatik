{
    "organizationId": "6afee98f0025956c6826",
    "projectId": "6afee9de002e7fecc9ae",
    "projectName": "AccaTik",
    "endpoint": "https://fra.cloud.appwrite.io/v1",
    "settings": {
        "services": {
            "account": true,
            "avatars": true,
            "databases": true,
            "locale": true,
            "health": true,
            "storage": true,
            "teams": true,
            "users": true,
            "sites": true,
            "functions": true,
            "graphql": true,
            "messaging": true
        },
        "protocols": {
            "rest": true,
            "graphql": true,
            "websocket": true
        },
        "auth": {
            "methods": {
                "jwt": true,
                "phone": true,
                "invites": true,
                "anonymous": true,
                "email-otp": true,
                "magic-url": true,
                "email-password": true
            },
            "security": {
                "duration": 31536000,
                "limit": null,
                "sessionsLimit": 10,
                "passwordHistory": null,
                "passwordDictionary": false,
                "personalDataCheck": false,
                "sessionAlerts": false,
                "mockNumbers": []
            }
        }
    },
    "sites": [
        {
            "$id": "6afeebc60038894d8725",
            "name": "accatik",
            "enabled": true,
            "logging": true,
            "framework": "react",
            "timeout": 30,
            "installCommand": "npm install",
            "buildCommand": "npm run build",
            "outputDirectory": "./dist",
            "buildRuntime": "node-22",
            "adapter": "static",
            "fallbackFile": "index.html",
            "path": "."
        }
    ],
    "functions": [
        {
            "$id": "accatik-api",
            "name": "AccaTik API",
            "runtime": "node-22",
            "path": ".",
            "entrypoint": "appwrite-function.ts",
            "commands": "npm install",
            "execute": ["any"],
            "events": [],
            "schedule": "",
            "interval": 0,
            "timeout": 60,
            "enabled": true,
            "logging": true
        },
        {
            "$id": "accatik-prewarm",
            "name": "AccaTik Slate Prewarm",
            "runtime": "node-22",
            "path": ".",
            "entrypoint": "appwrite-prewarm.ts",
            "commands": "npm install",
            "execute": ["any"],
            "events": [],
            "schedule": "0 2,18 * * *",
            "timeout": 300,
            "enabled": true,
            "logging": true
        },
        {
            "$id": "accatik-roi-daily",
            "name": "AccaTik Daily ROI Promotion",
            "runtime": "node-22",
            "path": ".",
            "entrypoint": "appwrite-roi-daily.ts",
            "commands": "npm install",
            "execute": ["any"],
            "events": [],
            "schedule": "0 3 * * *",
            "timeout": 300,
            "enabled": true,
            "logging": true
        }
    ]
}