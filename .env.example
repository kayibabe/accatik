# API_FOOTBALL_KEY: Required for live football fixtures, bookmaker odds, predictions, and team news.
# Configure this in Settings > Secrets in the AI Studio UI, or in a local .env file.
API_FOOTBALL_KEY="MY_API_FOOTBALL_KEY"

# API_FOOTBALL_BASE_URL: Optional. Point requests at your own gateway, proxy or
# regional mirror instead of the default host (https://v3.football.api-sports.io).
# When set, provider failover is disabled so the key only reaches this host.
# Include any path prefix the gateway expects (for example .../v3).
# API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"

# PORT: HTTP port for the Express server (default 3000).
PORT="3000"

# API_RATE_LIMIT_PER_MIN: Per-IP request cap for /api/fixtures/* (default 60).
# Protects the API-Football plan from refresh loops.
API_RATE_LIMIT_PER_MIN="60"

# API-Football quota visibility: /api/health reports the latest
# x-ratelimit-requests-* headers seen on an upstream response (limit, remaining
# and reset), plus a planHint when the limit is <= 100/day. No extra upstream
# call is made. The Appwrite Function accatik-prewarm warms today and tomorrow
# at 04:00 and 20:00 CAT (cron 0 2,18 * * * in UTC); it needs API_FOOTBALL_KEY,
# APPWRITE_API_KEY and a timeout long enough for two sequential cold slate builds.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional. Origin of the deployed Appwrite Function API.
# Leave blank for local development so fetches use relative /api routes.
# Example: VITE_API_BASE_URL="https://6afef91200114598853f.appwrite.network"
# VITE_API_BASE_URL=""
